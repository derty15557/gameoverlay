<Window x:Class="GameOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки"
        Height="600" Width="850"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">

    <!-- Внешний отступ, чтобы скруглённые углы не обрезались -->
    <Border Margin="16" 
            Background="#1E3A8A" 
            CornerRadius="16"
            BorderBrush="#3B82F6"
            BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== Заголовок ===== -->
            <Border Grid.Row="0" 
                    Background="#1E40AF"
                    CornerRadius="14,14,0,0">
                <Grid>
                    <TextBlock Text="Настройки"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="20,0,0,0"/>

                    <!-- Кнопка закрытия -->
                    <Button x:Name="CloseButton"
                            Width="42" Height="42"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Click="CloseButton_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#55FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                              Fill="White"
                              Width="18" Height="18"
                              Stretch="Uniform"/>
                    </Button>
                </Grid>
            </Border>

            <!-- ===== Контент ===== -->
            <Grid Grid.Row="1" Margin="24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Левое меню -->
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Text="Разделы" 
                               Foreground="#93C5FD"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Margin="6,0,0,10"/>

                    <!-- Общие (активная) -->
                    <Button Content="Общие" 
                            Height="40" Margin="0,0,0,6"
                            Foreground="White"
                            Background="#2563EB"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#2563EB" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="14,0,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#3B82F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Внешний вид -->
                    <Button Content="Внешний вид" 
                            Height="40" Margin="0,0,0,6"
                            Foreground="#DBEAFE"
                            Background="#1E40AF"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="14,0,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Горячие клавиши -->
                    <Button Content="Горячие клавиши" 
                            Height="40" Margin="0,0,0,6"
                            Foreground="#DBEAFE"
                            Background="#1E40AF"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="14,0,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- О программе -->
                    <Button Content="О программе" 
                            Height="40"
                            Foreground="#DBEAFE"
                            Background="#1E40AF"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="Transparent" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Left"
                                                      VerticalAlignment="Center"
                                                      Margin="14,0,0,0"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#2563EB"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Правая часть -->
                <Border Grid.Column="1" 
                        Background="#1E40AF"
                        CornerRadius="12"
                        Padding="24">
                    <StackPanel>
                        <TextBlock Text="Общие настройки"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,20"/>

                        <TextBlock Text="Здесь будут настройки оверлея."
                                   Foreground="#DBEAFE"
                                   FontSize="14"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="Пока что это просто заготовка."
                                   Foreground="#93C5FD"
                                   FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>