<Window x:Class="GameOverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GameOverlay"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style x:Key="SlotButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="52"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="#22FFFFFF" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsNavStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="12,0,0,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#15FFFFFF"/>
                                <Setter Property="Foreground" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="bg" Property="Background" Value="#25FFFFFF"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Фон -->
        <Border Background="#E6101015"/>

        <Grid>

            <!-- ===== Левая панель (выезжает слева) ===== -->
            <StackPanel x:Name="LeftPanel"
                        HorizontalAlignment="Left"
                        Width="72"
                        VerticalAlignment="Top"
                        Margin="0,16,0,0"
                        CacheMode="BitmapCache">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="LeftPanelTransform" X="0"/>
                </StackPanel.RenderTransform>

                <Button x:Name="BrowserButton"
                        Width="52" Height="52"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Браузер"
                        Click="BrowserButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="#22FFFFFF" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Path Data="M17.9,17.39C17.64,16.59 16.89,16 16,16H15V13A1,1 0 0,0 14,12H8V10H10A1,1 0 0,0 11,9V7H13A2,2 0 0,0 15,5V4.59C17.93,5.77 20,8.64 20,12C20,14.08 19.2,15.97 17.9,17.39M11,19.93C7.05,19.44 4,16.08 4,12C4,11.38 4.08,10.78 4.21,10.21L9,15V16A2,2 0 0,0 11,18M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2Z"
                          Fill="#DDDDDD" Width="26" Height="26" Stretch="Uniform"/>
                </Button>
            </StackPanel>

            <!-- ===== Верхняя плашка (выезжает сверху) ===== -->
            <Border x:Name="InfoPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,20,0,0"
                    Background="#CC1A1A20"
                    CornerRadius="10"
                    Padding="16,8"
                    CacheMode="BitmapCache">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="InfoPanelTransform" Y="0"/>
                </Border.RenderTransform>

                <StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <Image x:Name="ActiveAppIcon"
                               Width="20" Height="20"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>
                        <TextBlock x:Name="ActiveAppText"
                                   Text="Рабочий стол"
                                   Foreground="#E5E7EB"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <Border Width="1" Height="16" Background="#33FFFFFF"
                                Margin="12,0,12,0" VerticalAlignment="Center"/>

                        <TextBlock x:Name="FpsValue"
                                   Text="--"
                                   Foreground="#4ADE80"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" FPS"
                                   Foreground="#888888"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                        <Border Width="1" Height="16" Background="#33FFFFFF"
                                Margin="12,0,12,0" VerticalAlignment="Center"/>

                        <TextBlock x:Name="PingValue"
                                   Text="--"
                                   Foreground="#4ADE80"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" ms"
                                   Foreground="#888888"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Height="60"
                            Width="280"
                            Margin="0,8,0,0"
                            Background="#33000000"
                            CornerRadius="6"
                            ClipToBounds="True">
                        <Canvas x:Name="PingGraph"
                                SizeChanged="PingGraph_SizeChanged"
                                ClipToBounds="True"/>
                    </Border>
                </StackPanel>
            </Border>

            <!-- ===== Шестерёнка (выезжает справа) ===== -->
            <Button x:Name="SettingsButton"
                    Width="42" Height="42"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,16,0"
                    Background="Transparent"
                    BorderThickness="0"
                    Cursor="Hand"
                    ToolTip="Настройки"
                    Click="SettingsButton_Click"
                    CacheMode="BitmapCache">
                <Button.RenderTransform>
                    <TranslateTransform x:Name="SettingsButtonTransform" X="0"/>
                </Button.RenderTransform>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="Transparent" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"
                      Fill="#DDDDDD" Width="22" Height="22" Stretch="Uniform"/>
            </Button>

            <!-- ===== Слоты снизу (выезжают снизу) ===== -->
            <StackPanel x:Name="BottomPanel"
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,32"
                        CacheMode="BitmapCache">
                <StackPanel.RenderTransform>
                    <TranslateTransform x:Name="BottomPanelTransform" Y="0"/>
                </StackPanel.RenderTransform>

                <StackPanel x:Name="SlotsContainer" Orientation="Horizontal"/>
                <Border Width="1" Height="32" Background="#33FFFFFF"
                        Margin="4,0,14,0" VerticalAlignment="Center"/>
                <Button x:Name="AddSlotButton"
                        Style="{StaticResource SlotButtonStyle}"
                        Margin="0"
                        ToolTip="Добавить слот"
                        Click="AddSlotButton_Click">
                    <TextBlock Text="+" Foreground="#AAFFFFFF" FontSize="22"/>
                </Button>
            </StackPanel>

            <!-- ===== Браузер ===== -->
            <Grid x:Name="BrowserPanel" Visibility="Collapsed">
                <Border x:Name="BrowserBorder"
                        Width="1100" Height="750"
                        Background="#1A1A20"
                        CornerRadius="14"
                        BorderBrush="#3B82F6"
                        BorderThickness="2"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="BrowserTransform" X="0" Y="0"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="48"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="BrowserHeader"
                                Grid.Row="0"
                                Background="#252530"
                                CornerRadius="12,12,0,0"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="BrowserHeader_MouseLeftButtonDown"
                                MouseMove="BrowserHeader_MouseMove"
                                MouseLeftButtonUp="BrowserHeader_MouseLeftButtonUp">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Width="34" Height="34" Margin="8,0,2,0"
                                        VerticalAlignment="Center" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Назад"
                                        Click="BackButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Path Data="M20,11V13H8L13.5,18.5L12.08,19.92L4.16,12L12.08,4.08L13.5,5.5L8,11H20Z"
                                          Fill="#DDDDDD" Width="16" Height="16" Stretch="Uniform"/>
                                </Button>

                                <Button Grid.Column="1" Width="34" Height="34" Margin="0,0,2,0"
                                        VerticalAlignment="Center" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Вперёд"
                                        Click="ForwardButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Path Data="M4,13V11H16L10.5,5.5L11.92,4.08L19.84,12L11.92,19.92L10.5,18.5L16,13H4Z"
                                          Fill="#DDDDDD" Width="16" Height="16" Stretch="Uniform"/>
                                </Button>

                                <Border Grid.Column="2" Height="32" Margin="8,0"
                                        VerticalAlignment="Center"
                                        Background="#33FFFFFF" CornerRadius="16">
                                    <Grid>
                                        <TextBox x:Name="UrlBox" Margin="14,0,50,0"
                                                 VerticalContentAlignment="Center"
                                                 Background="Transparent" BorderThickness="0"
                                                 Foreground="White" CaretBrush="White"
                                                 FontSize="13" Text="https://www.google.com"
                                                 KeyDown="UrlBox_KeyDown"/>
                                        <Button Width="32" Height="32" HorizontalAlignment="Right"
                                                Background="Transparent" BorderThickness="0"
                                                Cursor="Hand" ToolTip="Перейти" Click="GoButton_Click">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bg" Background="Transparent" CornerRadius="16">
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bg" Property="Background" Value="#33FFFFFF"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Path Data="M5,12L19,12M13,5L20,12L13,19"
                                                  Stroke="#DDDDDD" StrokeThickness="2"
                                                  Width="14" Height="14" Stretch="Uniform"/>
                                        </Button>
                                    </Grid>
                                </Border>

                                <Button Grid.Column="3" Width="34" Height="34" Margin="0,0,8,0"
                                        VerticalAlignment="Center" Background="Transparent"
                                        BorderThickness="0" Cursor="Hand" ToolTip="Закрыть браузер"
                                        Click="CloseBrowserButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#55FF0000"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Fill="#FF6B6B" Width="16" Height="16" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Grid.Row="1" Background="#FFFFFF"
                                CornerRadius="0,0,12,12" ClipToBounds="True">
                            <wv2:WebView2 x:Name="Browser"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== Настройки ===== -->
            <Grid x:Name="SettingsPanel" Visibility="Collapsed" Background="#F008080B">
                <Border x:Name="SettingsBorder"
                        Width="820" Height="560"
                        Background="#16161A"
                        CornerRadius="12"
                        BorderBrush="#2A2A30"
                        BorderThickness="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="SettingsTransform" X="0" Y="0"/>
                    </Border.RenderTransform>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border x:Name="SettingsHeader"
                                Grid.Row="0"
                                Background="#1A1A20"
                                CornerRadius="12,12,0,0"
                                Cursor="SizeAll"
                                MouseLeftButtonDown="SettingsHeader_MouseLeftButtonDown"
                                MouseMove="SettingsHeader_MouseMove"
                                MouseLeftButtonUp="SettingsHeader_MouseLeftButtonUp">
                            <Grid>
                                <TextBlock Text="Настройки" Foreground="#E5E7EB"
                                           FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                                <Button Width="36" Height="36" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Margin="0,0,6,0"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" ToolTip="Закрыть"
                                        Click="CloseSettingsButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bg" Background="Transparent" CornerRadius="6">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bg" Property="Background" Value="#22FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <Path Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Fill="#9CA3AF" Width="14" Height="14" Stretch="Uniform"/>
                                </Button>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#111114"
                                    BorderBrush="#2A2A30" BorderThickness="0,0,1,0"
                                    Padding="10,14,10,14">
                                <StackPanel>
                                    <Button x:Name="NavGeneral" Tag="active"
                                            Content="Общие"
                                            Style="{StaticResource SettingsNavStyle}"
                                            Click="NavTab_Click"/>
                                    <Button x:Name="NavHotkeys"
                                            Content="Горячие клавиши"
                                            Style="{StaticResource SettingsNavStyle}"
                                            Click="NavTab_Click"/>
                                    <Button x:Name="NavPing"
                                            Content="Пинг"
                                            Style="{StaticResource SettingsNavStyle}"
                                            Click="NavTab_Click"/>
                                    <Button x:Name="NavPrograms"
                                            Content="Программы"
                                            Style="{StaticResource SettingsNavStyle}"
                                            Click="NavTab_Click"/>
                                    <Button x:Name="NavAbout"
                                            Content="О программе"
                                            Style="{StaticResource SettingsNavStyle}"
                                            Click="NavTab_Click"/>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Column="1">

                                <!-- Общие -->
                                <StackPanel x:Name="TabGeneral" Margin="28,24">
                                    <TextBlock Text="Общие" Foreground="#E5E7EB"
                                               FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Основные настройки оверлея."
                                               Foreground="#6B7280" FontSize="12"
                                               Margin="0,4,0,28"/>

                                    <TextBlock Text="ИНТЕРФЕЙС"
                                               Foreground="#6B7280" FontSize="10"
                                               FontWeight="SemiBold" Margin="0,0,0,10"/>

                                    <CheckBox x:Name="AnimationsCheck"
                                              Content="Включить анимации появления"
                                              Foreground="#E5E7EB"
                                              FontSize="13"
                                              IsChecked="True"
                                              Margin="0,0,0,8"
                                              Checked="AnimationsCheck_Changed"
                                              Unchecked="AnimationsCheck_Changed"/>

                                    <TextBlock Text="Если выключено — панели появляются мгновенно, без слайдов."
                                               Foreground="#6B7280" FontSize="11"
                                               TextWrapping="Wrap"/>
                                </StackPanel>

                                <!-- Горячие клавиши -->
                                <StackPanel x:Name="TabHotkeys" Margin="28,24" Visibility="Collapsed">
                                    <TextBlock Text="Горячие клавиши" Foreground="#E5E7EB"
                                               FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Настрой комбинацию для открытия оверлея."
                                               Foreground="#6B7280" FontSize="12"
                                               Margin="0,4,0,28"/>

                                    <TextBlock Text="ОТКРЫТИЕ ОВЕРЛЕЯ"
                                               Foreground="#6B7280" FontSize="10"
                                               FontWeight="SemiBold" Margin="0,0,0,10"/>

                                    <Border Background="#1F1F25" CornerRadius="8"
                                            Padding="14,12" Margin="0,0,0,10">
                                        <Grid>
                                            <TextBlock x:Name="HotkeyDisplay"
                                                       Text="Ctrl+Alt+O"
                                                       Foreground="#E5E7EB"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"/>
                                            <Button x:Name="ChangeHotkeyButton"
                                                    Content="Изменить"
                                                    HorizontalAlignment="Right"
                                                    Height="30"
                                                    Padding="14,0"
                                                    Foreground="#E5E7EB"
                                                    BorderThickness="0"
                                                    FontSize="12"
                                                    Cursor="Hand"
                                                    Click="ChangeHotkeyButton_Click">
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="bg" Background="#2A2A32" CornerRadius="6">
                                                            <ContentPresenter HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="bg" Property="Background" Value="#38383F"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Button.Template>
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <TextBlock x:Name="HotkeyHintText"
                                               Text="Нажми «Изменить» и введи новую комбинацию."
                                               Foreground="#6B7280" FontSize="12"/>
                                </StackPanel>

                                <!-- Пинг -->
                                <StackPanel x:Name="TabPing" Margin="28,24" Visibility="Collapsed">
                                    <TextBlock Text="Пинг" Foreground="#E5E7EB"
                                               FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="Настрой отображение пинга и график."
                                               Foreground="#6B7280" FontSize="12"
                                               Margin="0,4,0,24"/>

                                    <TextBlock Text="ПИНГОВАТЬ АКТИВНЫЙ ПРОЦЕСС"
                                               Foreground="#6B7280" FontSize="10"
                                               FontWeight="SemiBold" Margin="0,0,0,8"/>

                                    <CheckBox x:Name="PingProcessCheck"
                                              Content="Пинговать IP активного процесса (иначе 8.8.8.8)"
                                              Foreground="#E5E7EB"
                                              FontSize="13"
                                              IsChecked="True"
                                              Margin="0,0,0,24"/>

                                    <TextBlock Text="МАКСИМУМ ШКАЛЫ ГРАФИКА (мс)"
                                               Foreground="#6B7280" FontSize="10"
                                               FontWeight="SemiBold" Margin="0,0,0,8"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Content="100" Tag="100" Click="RangePreset_Click"
                                                Height="30" Padding="14,0" Margin="0,0,8,0"
